# ── Clerk (Auth) — get from https://dashboard.clerk.com → API Keys ────────────
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...   # Browser-safe, exposed in bundle
CLERK_SECRET_KEY=sk_test_...             # Server-only (Vercel function) — NEVER prefix with VITE_

# ── Neon (Database) ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
# SERVER-ONLY — NEVER prefix with VITE_

# ── App config ────────────────────────────────────────────────────────────────
VITE_GAS_WEBHOOK_URL=          # Google Apps Script webhook (public)
VITE_ADMIN_EMAIL=              # Admin e-mail shown in the UI (public)
