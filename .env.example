# ─────────────────────────────────────────────────────────────────────────────
# CLIENT-SIDE variables (VITE_ prefix — Vite inlines these into the browser bundle)
# Safe to expose: Supabase enforces security via Row Level Security (RLS), not by
# keeping these keys secret.
# In Netlify UI: uncheck "Contains secret values" for each of these.
# ─────────────────────────────────────────────────────────────────────────────

# Your Supabase project URL (public)
VITE_SUPABASE_URL=

# Supabase anon key — public by design; RLS controls what users can access
VITE_SUPABASE_ANON_KEY=

# Google Apps Script webhook endpoint
VITE_GAS_WEBHOOK_URL=

# Admin e-mail shown in the UI (not a secret)
VITE_ADMIN_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY — Netlify Functions / Build environment
# NEVER prefix with VITE_. Vite must never see or inline these values.
# In Netlify UI: mark as Secret, restrict to Production context.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase service-role key — bypasses RLS; server-side only!
SUPABASE_SERVICE_ROLE_KEY=
